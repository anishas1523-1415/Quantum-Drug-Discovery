# --- Core ---
SECRET_KEY=change-this-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173
FLASK_DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
# Leave unset for local/dev: app.py defaults to an absolute path at
# backend/users.db (SQLite). Run `flask db upgrade` once after setup.
# For production, point this at Postgres and run `flask db upgrade`:
# DATABASE_URL=postgresql://user:password@host:5432/quantum_drug_discovery

# --- Outbound email (password reset) ---
# Leave unset in dev: reset emails are logged to the console instead of sent.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=no-reply@yourdomain.com
