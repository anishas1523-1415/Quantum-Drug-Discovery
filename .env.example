# Copy to .env in this same directory before running `docker compose up --build`.
# `docker compose` reads a .env file here automatically for variable substitution.

# Required: generate with `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=

# Postgres (defaults are fine for local/dev use)
POSTGRES_USER=qdd
POSTGRES_PASSWORD=qdd_local_dev_password
POSTGRES_DB=quantum_drug_discovery

# Where the frontend is reachable from a browser (used for CORS)
FRONTEND_ORIGIN=http://localhost:8080
FRONTEND_PORT=8080

LOG_LEVEL=INFO

# Optional: outbound email for password resets. Leave blank to log
# reset emails to the backend container's stdout instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@yourdomain.com
